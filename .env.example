# Copier ce fichier en .env à la racine du projet et adapter les valeurs.
NODE_ENV=development
PORT=3001

# Mot de passe de l'espace BDE (OBLIGATOIRE en production)
ADMIN_PASSWORD=change-moi
# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères (OBLIGATOIRE en production)
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Base MySQL / MariaDB (valeurs XAMPP par défaut ; base « itic » importée via phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=itic

# Facultatif : forcer le flag Secure du cookie (par défaut : true en production)
# COOKIE_SECURE=true
